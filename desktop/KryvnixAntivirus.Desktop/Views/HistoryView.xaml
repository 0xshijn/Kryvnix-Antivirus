<UserControl x:Class="KryvnixAntivirus.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter & Export Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource KryvnixCardStyle}" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource KryvnixTextBox}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm kiếm sự kiện..." />
                    <ComboBox Grid.Column="2" Style="{StaticResource KryvnixComboBox}" ItemsSource="{Binding TimeRangeOptions}" SelectedIndex="{Binding SelectedTimeRangeIndex, Mode=TwoWay}" />
                    <Button Grid.Column="4" Content="Xuất CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource KryvnixSecondaryButton}" />
                    <Button Grid.Column="6" Content="Xuất JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource KryvnixSecondaryButton}" />
                    <Button Grid.Column="8" Content="Xóa lịch sử" Command="{Binding ClearHistoryCommand}" Style="{StaticResource KryvnixDangerButton}" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Tất cả" GroupName="HistFilter" Style="{StaticResource FilterPillButton}" IsChecked="True" Command="{Binding SetFilterCommand}" CommandParameter="All" />
                    <RadioButton Content="Quét virus" GroupName="HistFilter" Style="{StaticResource FilterPillButton}" Command="{Binding SetFilterCommand}" CommandParameter="Scan" />
                    <RadioButton Content="Mối đe dọa" GroupName="HistFilter" Style="{StaticResource FilterPillButton}" Command="{Binding SetFilterCommand}" CommandParameter="Threat" />
                    <RadioButton Content="Khu cách ly" GroupName="HistFilter" Style="{StaticResource FilterPillButton}" Command="{Binding SetFilterCommand}" CommandParameter="Quarantine" />
                    <RadioButton Content="Cập nhật" GroupName="HistFilter" Style="{StaticResource FilterPillButton}" Command="{Binding SetFilterCommand}" CommandParameter="Update" />
                    <RadioButton Content="Bảo vệ" GroupName="HistFilter" Style="{StaticResource FilterPillButton}" Command="{Binding SetFilterCommand}" CommandParameter="Protection" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#4ADE80" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Timeline Feed -->
        <Border Grid.Row="1" Style="{StaticResource KryvnixCardStyle}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#1E2B3C" BorderThickness="0,0,0,1" Padding="4,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="{Binding EventType, Converter={StaticResource ActivityTypeToBg}}"
                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{Binding EventType, Converter={StaticResource ActivityTypeToIcon}}"
                                              Fill="{Binding EventType, Converter={StaticResource ActivityTypeToBrush}}"
                                              Width="16" Height="16" Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                            <Border CornerRadius="5" Padding="7,1.5" Margin="10,0,0,0"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityToBg}}">
                                                <TextBlock Text="{Binding Severity}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}}"
                                               FontSize="12" Foreground="#7D91A8" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
