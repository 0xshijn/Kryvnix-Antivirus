<UserControl x:Class="KryvnixAntivirus.Desktop.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Summary Metrics Row -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource StatAmberCardBrush}" BorderBrush="#574122" BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Tệp đang cách ly" FontSize="12.5" Foreground="#D1BC9D" />
                    <TextBlock Text="{Binding TotalCount, Converter={StaticResource DotNumber}}" Style="{StaticResource StatNumberStyle}" Foreground="#FBBF24" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource StatBlueCardBrush}" BorderBrush="#254468" BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Dung lượng kho mã hóa" FontSize="12.5" Foreground="#9AB0C7" />
                    <TextBlock Text="{Binding TotalSizeBytes, Converter={StaticResource FileSize}}" Style="{StaticResource StatNumberStyle}" Foreground="#38BDF8" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource KryvnixCardStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Kho lưu trữ AES-256-GCM (.kqv)" FontSize="12.5" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding VaultPath}" FontSize="12.5" Foreground="#22C55E" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toolbar: Search + Category + Purge -->
        <Border Grid.Row="1" Style="{StaticResource KryvnixCardStyle}" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource KryvnixTextBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Tìm theo tên tệp, đường dẫn hoặc tên mã độc..." />
                <ComboBox Grid.Column="2" Style="{StaticResource KryvnixComboBox}"
                          ItemsSource="{Binding CategoryFilters}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                <Button Grid.Column="4" Content="Dọn sạch khu cách ly"
                        Command="{Binding PurgeAllCommand}"
                        Style="{StaticResource KryvnixDangerButton}" />
            </Grid>
        </Border>

        <!-- Quarantine List -->
        <Border Grid.Row="2" Style="{StaticResource KryvnixCardStyle}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Khu cách ly hiện đang trống — không có tệp nguy hiểm nào bị cô lập."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="4,10"
                               Visibility="{Binding FilteredItems.Count, Converter={StaticResource PositiveIntToVis}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="38" Height="38" CornerRadius="10" Background="#332615" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconLock}" Fill="#F59E0B" Width="17" Height="18" Stretch="Uniform" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OriginalName}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                <Border CornerRadius="6" Padding="8,2" Margin="10,0,0,0"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBg}}">
                                                    <TextBlock Text="{Binding ThreatName}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </Border>
                                                <Border CornerRadius="6" Padding="7,2" Margin="6,0,0,0" Background="#1A283A">
                                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#94A3B8" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding OriginalPath}" FontSize="12" Foreground="#8A9BB0" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSize}}" FontSize="11.5" Foreground="#64748B" />
                                                <TextBlock Text="  •  Cách ly lúc: " FontSize="11.5" Foreground="#64748B" />
                                                <TextBlock Text="{Binding QuarantinedAt, Converter={StaticResource RelativeTime}}" FontSize="11.5" Foreground="#64748B" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Khôi phục"
                                                    Command="{Binding DataContext.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KryvnixSecondaryButton}"
                                                    Padding="12,6" Margin="0,0,6,0" />
                                            <Button Content="Lưu nơi khác"
                                                    Command="{Binding DataContext.RestoreToCustomPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KryvnixSecondaryButton}"
                                                    Padding="10,6" Margin="0,0,6,0" />
                                            <Button Content="Xóa vĩnh viễn"
                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KryvnixDangerButton}"
                                                    Padding="12,6" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
