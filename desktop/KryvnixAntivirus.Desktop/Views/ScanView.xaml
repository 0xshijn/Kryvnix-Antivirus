<UserControl x:Class="KryvnixAntivirus.Desktop.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:KryvnixAntivirus.Desktop.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">

            <!-- Mode Selector Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Quick Scan Card -->
                <RadioButton Grid.Column="0" GroupName="ScanModeGroup" IsChecked="{Binding IsQuickSelected, Mode=OneWay}"
                             Command="{Binding SelectModeCommand}" CommandParameter="{x:Static models:ScanMode.Quick}" Cursor="Hand">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="#141E2B" BorderBrush="#253447" BorderThickness="1.5" CornerRadius="14" Padding="18">
                                <StackPanel>
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#143728" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconBolt}" Fill="#22C55E" Width="20" Height="20" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="Quét nhanh" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                    <TextBlock Text="Quét Downloads, Desktop, Startup và thư mục tạm (nhanh, ít tài nguyên)."
                                               FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#122B24" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#22C55E" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#34D372" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <!-- Full Scan Card -->
                <RadioButton Grid.Column="2" GroupName="ScanModeGroup" IsChecked="{Binding IsFullSelected, Mode=OneWay}"
                             Command="{Binding SelectModeCommand}" CommandParameter="{x:Static models:ScanMode.Full}" Cursor="Hand">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="#141E2B" BorderBrush="#253447" BorderThickness="1.5" CornerRadius="14" Padding="18">
                                <StackPanel>
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#173049" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconHardDrive}" Fill="#38BDF8" Width="20" Height="20" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="Quét toàn bộ" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                    <TextBlock Text="Kiểm tra sâu toàn bộ thư mục người dùng, AppData và hệ thống tệp."
                                               FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#122B24" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#22C55E" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#34D372" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <!-- Custom Scan Card -->
                <RadioButton Grid.Column="4" GroupName="ScanModeGroup" IsChecked="{Binding IsCustomSelected, Mode=OneWay}"
                             Command="{Binding SelectModeCommand}" CommandParameter="{x:Static models:ScanMode.Custom}" Cursor="Hand">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="#141E2B" BorderBrush="#253447" BorderThickness="1.5" CornerRadius="14" Padding="18">
                                <StackPanel>
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#2E2417" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconFolder}" Fill="#F59E0B" Width="20" Height="20" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="Quét tùy chỉnh" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                    <TextBlock Text="Chọn thủ công hoặc kéo thả tệp/thư mục cụ thể để phân tích chuyên sâu."
                                               FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#122B24" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#22C55E" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#34D372" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </Grid>

            <!-- Custom Target Picker & Drag-Drop Zone -->
            <Border Style="{StaticResource KryvnixCardStyle}"
                    Margin="0,16,0,0"
                    AllowDrop="True"
                    Drop="DropZone_Drop"
                    DragOver="DropZone_DragOver"
                    Visibility="{Binding IsCustomSelected, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Vị trí quét tùy chỉnh (Hỗ trợ kéo thả tệp hoặc thư mục vào đây)" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Thêm nhiều tệp/thư mục cần kiểm tra bằng SHA-256, YARA và PE Heuristic." Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Thêm thư mục" Command="{Binding BrowseFolderCommand}" Style="{StaticResource KryvnixSecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="+ Thêm tệp" Command="{Binding BrowseFilesCommand}" Style="{StaticResource KryvnixSecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="Xóa danh sách" Command="{Binding ClearTargetsCommand}" Style="{StaticResource KryvnixGhostButton}" Foreground="#94A3B8" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CustomTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#101925" BorderBrush="#263549" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4">
                                    <Grid>
                                        <TextBlock Text="{Binding}" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Content="✕"
                                                Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource KryvnixGhostButton}"
                                                Foreground="#94A3B8"
                                                HorizontalAlignment="Right" Padding="6,2" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Live Scan Progress & Controls Card -->
            <Border Style="{StaticResource KryvnixCardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tiến trình quét mã độc" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding StatusBanner}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding CreateAndScanSafeEicarTestCommand}"
                                    Style="{StaticResource KryvnixSecondaryButton}"
                                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                    Margin="0,0,10,0"
                                    ToolTip="Tạo tệp kiểm thử chuẩn quốc tế EICAR vô hại và quét thử nghiệm ngay">
                                <TextBlock Text="Thử nghiệm EICAR" />
                            </Button>

                            <Button Command="{Binding StartSelectedScanCommand}"
                                    Style="{StaticResource KryvnixPrimaryButton}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlay}" Fill="#061E11" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Bắt đầu quét" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding TogglePauseCommand}"
                                    Style="{StaticResource KryvnixSecondaryButton}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding PauseButtonLabel}" />
                            </Button>

                            <Button Command="{Binding CancelScanCommand}"
                                    Style="{StaticResource KryvnixDangerButton}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Dừng quét" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Progress Bar & Current File Path -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding CurrentFilePath}" FontSize="12.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0.0}%'}" FontSize="13" FontWeight="SemiBold" Foreground="#22C55E" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Style="{StaticResource KryvnixProgressBar}"
                                 Value="{Binding ProgressPercent}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Maximum="100"
                                 Margin="0,0,0,16" />

                    <!-- 4 Live Telemetry Counters -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Tệp đã quét" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding FilesScanned, Converter={StaticResource DotNumber}}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Mối đe dọa phát hiện" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding ThreatsFound, Converter={StaticResource DotNumber}}" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Tốc độ quét" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding FilesPerSecond, StringFormat='{}{0:0.0} tệp/giây'}" FontSize="20" FontWeight="Bold" Foreground="#22C55E" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Thời gian" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding ElapsedDisplay}" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Detected Threats List -->
            <Border Style="{StaticResource KryvnixCardStyle}" Margin="0,16,0,4">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconShieldAlert}" Fill="#EF4444" Width="17" Height="17" Stretch="Uniform" Margin="0,0,9,0" />
                            <TextBlock Text="Mối đe dọa phát hiện trong phiên" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <Button Content="Cách ly tất cả"
                                Command="{Binding QuarantineAllCommand}"
                                Style="{StaticResource KryvnixPrimaryButton}"
                                Padding="14,7"
                                HorizontalAlignment="Right"
                                Visibility="{Binding DetectedThreats.Count, Converter={StaticResource PositiveIntToVis}}" />
                    </Grid>

                    <TextBlock Text="Chưa phát hiện mối đe dọa nào trong phiên quét hiện tại."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,6"
                               Visibility="{Binding DetectedThreats.Count, Converter={StaticResource PositiveIntToVis}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding DetectedThreats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#101925" BorderBrush="#3B232B" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ThreatName}" FontSize="14" FontWeight="SemiBold" Foreground="#FCA5A5" />
                                                <Border CornerRadius="6" Padding="8,2" Margin="10,0,0,0"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBg}}">
                                                    <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </Border>
                                                <Border CornerRadius="6" Padding="8,2" Margin="6,0,0,0" Background="#19283B">
                                                    <TextBlock Text="{Binding DetectionMethod}" FontSize="11" Foreground="#38BDF8" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FilePath}" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="Cách ly"
                                                    Command="{Binding DataContext.QuarantineThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KryvnixPrimaryButton}"
                                                    Padding="12,6" Margin="0,0,6,0" />
                                            <Button Content="Xóa"
                                                    Command="{Binding DataContext.DeleteThreatFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KryvnixDangerButton}"
                                                    Padding="12,6" Margin="0,0,6,0" />
                                            <Button Content="Ngoại lệ"
                                                    Command="{Binding DataContext.ExcludeThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource KryvnixSecondaryButton}"
                                                    Padding="10,6" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
