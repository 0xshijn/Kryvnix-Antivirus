<Window x:Class="KryvnixAntivirus.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:KryvnixAntivirus.Desktop.Models"
        xmlns:vm="clr-namespace:KryvnixAntivirus.Desktop.ViewModels"
        xmlns:views="clr-namespace:KryvnixAntivirus.Desktop.Views"
        Title="Kryvnix Antivirus"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B111B"
        FontFamily="{StaticResource PrimaryFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="68"
                            ResizeBorderThickness="6"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RealtimeProtectionViewModel}">
            <views:RealtimeProtectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
            <views:QuarantineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Sidebar Navigation Item Style -->
        <Style x:Key="SidebarNavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="10,3" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="11,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ActiveEdge"
                                    Width="3.5"
                                    Height="22"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    Background="#4ADE80"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#172334" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ActiveNavBrush}" />
                                <Setter TargetName="ActiveEdge" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowOuterBorder"
            Background="#0B111B"
            BorderBrush="#1E2B3B"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT NAVIGATION SIDEBAR ==================== -->
            <Border Grid.Column="0"
                    Width="{Binding SidebarWidth}"
                    Background="#0F1824"
                    BorderBrush="#1C293B"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Grid>
                    <!-- Decorative subtle emerald wave glow at lower sidebar matching reference image -->
                    <Canvas IsHitTestVisible="False" VerticalAlignment="Bottom" Height="220">
                        <Ellipse Width="260" Height="140" Canvas.Left="-40" Canvas.Top="70" Opacity="0.22">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#1FD168" Offset="0" />
                                    <GradientStop Color="#0D6E52" Offset="0.45" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Path StrokeThickness="2" Opacity="0.45"
                              Data="M -20,165 C 45,105 140,95 250,148">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="#22C55E" Offset="0.48" />
                                    <GradientStop Color="#14B8A6" Offset="0.82" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                        </Path>
                        <Path StrokeThickness="1.2" Opacity="0.28"
                              Data="M -10,185 C 60,128 155,118 255,168">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="#34D399" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                        </Path>
                    </Canvas>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Brand Logo & Collapse/Expand Toggle -->
                        <Grid Grid.Row="0">
                            <!-- Expanded Sidebar Header (240px) -->
                            <Grid Margin="14,18,12,20"
                                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Kryvnix Shield Logo -->
                                <Grid Width="38" Height="42" VerticalAlignment="Center">
                                    <Ellipse Width="42" Height="42" Opacity="0.35">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#22C55E" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Viewbox Width="34" Height="38">
                                        <Canvas Width="36" Height="40">
                                            <Path Data="M18,2 L32,8 L31,20 C31,29 25,35 18,38 C11,35 5,29 5,20 L4,8 Z">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#4ADE80" Offset="0" />
                                                        <GradientStop Color="#22C55E" Offset="0.55" />
                                                        <GradientStop Color="#15803D" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                            </Path>
                                            <Path Data="M18,6 L28,10.5 L27.3,19.8 C27.3,26.6 22.8,31.2 18,33.6 C13.2,31.2 8.7,26.6 8.7,19.8 L8,10.5 Z"
                                                  Fill="#0D2620" Opacity="0.72" />
                                            <Path Data="M12.5,20 L16.5,24 L24.5,14.5"
                                                  Stroke="#4ADE80" StrokeThickness="2.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Kryvnix" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" LineHeight="18" />
                                    <TextBlock Text="Antivirus" FontSize="16" FontWeight="Bold" Foreground="#E2E8F0" LineHeight="18" Margin="0,-2,0,0" />
                                    <TextBlock Text="v2.0.0" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Command="{Binding ToggleSidebarCommand}"
                                        Style="{StaticResource WindowCaptionButton}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        Width="30" Height="30"
                                        ToolTip="Thu gọn thanh điều hướng"
                                        VerticalAlignment="Top">
                                    <Path Data="{StaticResource IconSidebarToggle}"
                                          Fill="#94A3B8"
                                          Width="14" Height="14"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Collapsed Sidebar Header (72px): Stacked Shield + Centered Expand Button -->
                            <StackPanel Margin="0,14,0,12"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}}">
                                <Grid Width="36" Height="38" HorizontalAlignment="Center">
                                    <Ellipse Width="38" Height="38" Opacity="0.35">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#22C55E" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Viewbox Width="32" Height="36">
                                        <Canvas Width="36" Height="40">
                                            <Path Data="M18,2 L32,8 L31,20 C31,29 25,35 18,38 C11,35 5,29 5,20 L4,8 Z">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#4ADE80" Offset="0" />
                                                        <GradientStop Color="#22C55E" Offset="0.55" />
                                                        <GradientStop Color="#15803D" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                            </Path>
                                            <Path Data="M18,6 L28,10.5 L27.3,19.8 C27.3,26.6 22.8,31.2 18,33.6 C13.2,31.2 8.7,26.6 8.7,19.8 L8,10.5 Z"
                                                  Fill="#0D2620" Opacity="0.72" />
                                            <Path Data="M12.5,20 L16.5,24 L24.5,14.5"
                                                  Stroke="#4ADE80" StrokeThickness="2.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>

                                <Button Command="{Binding ToggleSidebarCommand}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        Width="44" Height="32"
                                        Margin="0,10,0,0"
                                        Cursor="Hand"
                                        ToolTip="Mở rộng thanh điều hướng">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="#162335" BorderBrush="#25364B" BorderThickness="1" CornerRadius="8">
                                                <Path x:Name="Ico" Data="{StaticResource IconSidebarToggle}" Fill="#CBD5E1" Width="15" Height="15" Stretch="Uniform" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#163B2C" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#22C55E" />
                                                    <Setter TargetName="Ico" Property="Fill" Value="#4ADE80" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Navigation Items -->
                        <StackPanel Grid.Row="1" Margin="0,2,0,0">
                            <!-- Tổng quan -->
                            <RadioButton GroupName="MainNav"
                                         Style="{StaticResource SidebarNavItemStyle}"
                                         IsChecked="{Binding IsDashboardSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationPage.Dashboard}"
                                         ToolTip="Tổng quan">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconHome}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Tổng quan" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </RadioButton>

                            <!-- Quét virus -->
                            <RadioButton GroupName="MainNav"
                                         Style="{StaticResource SidebarNavItemStyle}"
                                         IsChecked="{Binding IsScanSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationPage.VirusScan}"
                                         ToolTip="Quét virus">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconSearch}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Quét virus" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </RadioButton>

                            <!-- Bảo vệ thời gian thực -->
                            <RadioButton GroupName="MainNav"
                                         Style="{StaticResource SidebarNavItemStyle}"
                                         IsChecked="{Binding IsRealtimeSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationPage.RealtimeProtection}"
                                         ToolTip="Bảo vệ thời gian thực">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconShieldCheck}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Bảo vệ thời gian thực" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </RadioButton>

                            <!-- Khu cách ly -->
                            <RadioButton GroupName="MainNav"
                                         Style="{StaticResource SidebarNavItemStyle}"
                                         IsChecked="{Binding IsQuarantineSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationPage.Quarantine}"
                                         ToolTip="Khu cách ly">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconLock}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="16" Height="17" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Khu cách ly" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </RadioButton>

                            <!-- Lịch sử hoạt động -->
                            <RadioButton GroupName="MainNav"
                                         Style="{StaticResource SidebarNavItemStyle}"
                                         IsChecked="{Binding IsHistorySelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationPage.ActivityHistory}"
                                         ToolTip="Lịch sử hoạt động">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconHistory}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Lịch sử hoạt động" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </RadioButton>

                            <!-- Cập nhật (with emerald pending update dot!) -->
                            <RadioButton GroupName="MainNav"
                                         Style="{StaticResource SidebarNavItemStyle}"
                                         IsChecked="{Binding IsUpdatesSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationPage.Updates}"
                                         ToolTip="Cập nhật">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconSync}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Cập nhật" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                                    <Ellipse Grid.Column="2"
                                             Width="7" Height="7"
                                             Fill="#22C55E"
                                             Margin="4,0,2,0"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding HasPendingUpdate, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </RadioButton>

                            <!-- Cài đặt -->
                            <RadioButton GroupName="MainNav"
                                         Style="{StaticResource SidebarNavItemStyle}"
                                         IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static models:NavigationPage.Settings}"
                                         ToolTip="Cài đặt">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconSettings}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Cài đặt" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Compact System Protection Status Card -->
                        <Border Grid.Row="2"
                                Margin="10,0,10,14"
                                Padding="10,10"
                                CornerRadius="12"
                                Background="#112228"
                                BorderBrush="#1D3E38"
                                BorderThickness="1"
                                ToolTip="{Binding SidebarStatusTitle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="#13342A" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconMonitor}"
                                          Fill="{Binding SidebarStatusAccentHex, Converter={StaticResource HexToBrush}}"
                                          Width="15" Height="15" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{Binding SidebarStatusTitle}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#F1F5F9"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Real-time Protection: "
                                                   FontSize="10.5"
                                                   Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding SidebarRealtimeValue}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding SidebarStatusAccentHex, Converter={StaticResource HexToBrush}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== RIGHT MAIN WORKSPACE ==================== -->
            <Grid Grid.Column="1" Background="#0B111B">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom Windows 11 Top Title Bar -->
                <Grid Grid.Row="0" Margin="24,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Current Page Icon + Title + Subtitle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#162335" BorderBrush="#233349" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="HeaderPageIcon"
                                  Fill="#E2E8F0"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Data="{StaticResource IconHome}" />
                        </Border>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC" />
                            <TextBlock Text="{Binding PageSubtitle}"
                                       FontSize="12"
                                       Foreground="#889BB0"
                                       Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Top-Right Utilities + Caption Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <!-- Notification Bell with Unread Badge -->
                        <Button x:Name="NotificationBtn"
                                Command="{Binding ToggleNotificationsCommand}"
                                Width="38" Height="38"
                                Margin="0,0,12,0"
                                Cursor="Hand"
                                ToolTip="Thông báo bảo mật">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#152030" BorderBrush="#243447" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <Path Data="{StaticResource IconBell}"
                                                  Fill="#CBD5E1"
                                                  Width="16" Height="16" Stretch="Uniform" />
                                            <Ellipse Width="8" Height="8"
                                                     Fill="#EF4444"
                                                     Stroke="#152030" StrokeThickness="1.5"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,7,7,0"
                                                     Visibility="{Binding UnreadNotificationsCount, Converter={StaticResource PositiveIntToVis}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1E2C3E" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- User Profile Dropdown Trigger -->
                        <Button x:Name="UserMenuBtn"
                                Command="{Binding ToggleAccountMenuCommand}"
                                Margin="0,0,16,0"
                                Cursor="Hand"
                                ToolTip="Tài khoản &amp; Thông tin thiết bị">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="6,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="#233144" BorderBrush="#33465E" BorderThickness="1">
                                                <Grid>
                                                    <Path Data="{StaticResource IconUser}" Fill="#CBD5E1" Width="16" Height="16" Stretch="Uniform"
                                                          Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVis}}" />
                                                    <Border CornerRadius="17" Background="#143D2C" BorderBrush="#22C55E" BorderThickness="1"
                                                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding UserInitials}" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="#7D91A8" Margin="0,-1,0,0" />
                                            </StackPanel>
                                            <Path Data="{StaticResource IconChevronDown}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#162232" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Window Minimize / Maximize / Close -->
                        <Button Style="{StaticResource WindowCaptionButton}" Click="MinimizeButton_Click" ToolTip="Thu nhỏ">
                            <Path Data="{StaticResource IconWinMinimize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="MaxRestoreBtn" Style="{StaticResource WindowCaptionButton}" Click="MaxRestoreButton_Click" ToolTip="Phóng to / Khôi phục">
                            <Path x:Name="MaxRestoreIcon" Data="{StaticResource IconWinMaximize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" ToolTip="Đóng (hoặc thu nhỏ xuống khay hệ thống)">
                            <Path Data="{StaticResource IconWinClose}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Active Page View Content -->
                <ContentControl Grid.Row="1"
                                Margin="22,2,22,14"
                                Content="{Binding CurrentViewModel}" />

                <!-- Notifications Popover -->
                <Popup PlacementTarget="{Binding ElementName=NotificationBtn}"
                       Placement="Bottom"
                       HorizontalOffset="-260"
                       VerticalOffset="8"
                       IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Width="340" Background="#131E2C" BorderBrush="#293A50" BorderThickness="1" CornerRadius="14" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Thông báo gần đây" FontSize="14.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                <Button Content="Đánh dấu đã đọc"
                                        Command="{Binding MarkAllNotificationsReadCommand}"
                                        Style="{StaticResource KryvnixGhostButton}"
                                        HorizontalAlignment="Right"
                                        FontSize="12" Padding="4,2" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RecentNotifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1E2B3C" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14"
                                                        Background="{Binding EventType, Converter={StaticResource ActivityTypeToBg}}"
                                                        VerticalAlignment="Top" Margin="0,2,10,0">
                                                    <Path Data="{Binding EventType, Converter={StaticResource ActivityTypeToIcon}}"
                                                          Fill="{Binding EventType, Converter={StaticResource ActivityTypeToBrush}}"
                                                          Width="13" Height="13" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}}" FontSize="10.5" Foreground="#64748B" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- User Account Menu Popover -->
                <Popup PlacementTarget="{Binding ElementName=UserMenuBtn}"
                       Placement="Bottom"
                       HorizontalOffset="-105"
                       VerticalOffset="8"
                       IsOpen="{Binding IsAccountMenuOpen, Mode=TwoWay}"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Width="280" Background="#131E2C" BorderBrush="#293A50" BorderThickness="1" CornerRadius="14" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#163A2C" BorderBrush="#22C55E" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding UserInitials}" FontSize="13" FontWeight="Bold" Foreground="#4ADE80"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                    <TextBlock Text="{Binding UserEmail}" FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="195" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding DeviceId, StringFormat='Mã thiết bị: {0}'}" FontSize="11" Foreground="#64748B" />
                            <TextBlock Text="{Binding EngineModeLabel, StringFormat='Engine: {0}'}" FontSize="11" Foreground="#22C55E" Margin="0,2,0,10" TextWrapping="Wrap" />

                            <!-- Guest actions: Register & Login -->
                            <StackPanel Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVis}}">
                                <Button Content="Đăng ký tài khoản mới"
                                        Command="{Binding OpenRegisterDialogCommand}"
                                        Style="{StaticResource KryvnixPrimaryButton}"
                                        Margin="0,0,0,8" />
                                <Button Content="Đăng nhập tài khoản"
                                        Command="{Binding OpenLoginDialogCommand}"
                                        Style="{StaticResource KryvnixSecondaryButton}"
                                        Margin="0,0,0,10" />
                            </StackPanel>

                            <!-- Authenticated actions: Change Password & Logout -->
                            <StackPanel Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                                <Button Content="Đổi mật khẩu"
                                        Command="{Binding OpenChangePasswordDialogCommand}"
                                        Style="{StaticResource KryvnixSecondaryButton}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8" />
                                <Button Content="Đăng xuất tài khoản"
                                        Command="{Binding LogoutCommand}"
                                        Style="{StaticResource KryvnixSecondaryButton}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,0,0,10" />
                            </StackPanel>

                            <Border Height="1" Background="#1E2B3C" Margin="0,0,0,10" />
                            <Button Content="Mở Cài đặt hệ thống"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static models:NavigationPage.Settings}"
                                    Style="{StaticResource KryvnixSecondaryButton}"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,0,0,8" />
                            <Button Content="Thu nhỏ xuống khay hệ thống"
                                    Click="HideToTrayMenu_Click"
                                    Style="{StaticResource KryvnixSecondaryButton}"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,0,0,8" />
                            <Button Content="Thoát Kryvnix Antivirus"
                                    Click="ExitAppMenu_Click"
                                    Style="{StaticResource KryvnixDangerButton}"
                                    HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Full-Window Authentication Modal Overlay (Register / Login / Change Password) -->
            <views:AuthDialogView Grid.ColumnSpan="2"
                                  DataContext="{Binding AuthVm}"
                                  Panel.ZIndex="100" />
        </Grid>
    </Border>
</Window>
