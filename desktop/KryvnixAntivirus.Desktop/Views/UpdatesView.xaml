<UserControl x:Class="KryvnixAntivirus.Desktop.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">

            <!-- Update Status Hero Card -->
            <Border Style="{StaticResource KryvnixCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="54" Height="54" CornerRadius="14" Background="#143629" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSync}" Fill="#22C55E" Width="26" Height="26" Stretch="Uniform" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Cơ sở dữ liệu chữ ký mã độc" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                <Border Background="#133827" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="8" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Ed25519BadgeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#4ADE80" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Kiểm tra &amp; Cập nhật ngay"
                                Command="{Binding CheckAndUpdateCommand}"
                                Style="{StaticResource KryvnixPrimaryButton}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar Style="{StaticResource KryvnixProgressBar}"
                                 Value="{Binding UpdateProgress}"
                                 Maximum="100"
                                 Margin="0,16,0,0"
                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />

                    <!-- 4 Key DB Info Cards -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Phiên bản CSDL" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding DatabaseVersion}" FontSize="19" FontWeight="Bold" Foreground="#22C55E" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Tổng số chữ ký SHA-256" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding TotalSignatures, Converter={StaticResource DotNumber}}" FontSize="19" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Quy tắc YARA hoạt động" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding YaraRuleCount, Converter={StaticResource DotNumber}}" FontSize="19" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Phiên bản ứng dụng" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding AppVersion}" FontSize="19" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Auto-Update Schedule -->
            <Border Style="{StaticResource KryvnixCardStyle}" Margin="0,16,0,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lịch kiểm tra cập nhật tự động" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Gói chữ ký được kiểm tra toàn vẹn bằng chữ ký số Ed25519 và áp dụng qua SQLite transaction an toàn." Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ComboBox Style="{StaticResource KryvnixComboBox}"
                              ItemsSource="{Binding AutoUpdateOptions}"
                              SelectedIndex="{Binding AutoUpdateIntervalIndex, Mode=TwoWay}"
                              Width="210"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Update History -->
            <Border Style="{StaticResource KryvnixCardStyle}" Margin="0,16,0,4">
                <StackPanel>
                    <TextBlock Text="Lịch sử các bản cập nhật CSDL" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#101925" BorderBrush="#233144" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version}" FontSize="14.5" FontWeight="Bold" Foreground="#22C55E" />
                                                <Border Background="#153729" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding SignaturesAdded, StringFormat='+{0:N0} chữ ký'}" FontSize="11.5" Foreground="#4ADE80" />
                                                </Border>
                                                <Border Background="#14293D" CornerRadius="6" Padding="8,2" Margin="6,0,0,0">
                                                    <TextBlock Text="Ed25519 Verified" FontSize="11" Foreground="#38BDF8" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Changelog}" FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding InstalledAt, Converter={StaticResource RelativeTime}}"
                                                   FontSize="12" Foreground="#7D91A8" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
