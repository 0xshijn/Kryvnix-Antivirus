<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Palette Tokens -->
    <Color x:Key="BgPrimaryColor">#0B111B</Color>
    <Color x:Key="BgSecondaryColor">#101925</Color>
    <Color x:Key="BgSidebarColor">#111B28</Color>
    <Color x:Key="CardBgColor">#141E2B</Color>
    <Color x:Key="CardSurfaceColor">#182230</Color>
    <Color x:Key="CardHoverColor">#202D3D</Color>
    <Color x:Key="BorderColor">#293748</Color>
    <Color x:Key="BorderSubtleColor">#1E2B3B</Color>

    <Color x:Key="AccentPrimaryColor">#22C55E</Color>
    <Color x:Key="AccentLightColor">#34D372</Color>
    <Color x:Key="AccentHoverColor">#16A34A</Color>
    <Color x:Key="AccentDarkColor">#14532D</Color>

    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="BorderBrushDefault" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- Gradients matching reference visual hierarchy -->
    <LinearGradientBrush x:Key="ActiveNavBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#27C965" Offset="0.0" />
        <GradientStop Color="#1F9A52" Offset="0.28" />
        <GradientStop Color="#144A34" Offset="0.82" />
        <GradientStop Color="#103128" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="QuickScanActionBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#44E082" Offset="0.0" />
        <GradientStop Color="#22C55E" Offset="0.55" />
        <GradientStop Color="#19B252" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="QuickScanActionHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#56E890" Offset="0.0" />
        <GradientStop Color="#2BD46A" Offset="0.55" />
        <GradientStop Color="#1EC35C" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatBlueCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#172A40" Offset="0.0" />
        <GradientStop Color="#142031" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatRedCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2D1B23" Offset="0.0" />
        <GradientStop Color="#1F1A24" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatAmberCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2B2219" Offset="0.0" />
        <GradientStop Color="#1D1E26" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatEmeraldCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#132D27" Offset="0.0" />
        <GradientStop Color="#14222B" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
